{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.nonax_architect.work": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "look", "move" ],
          "transitions": [
            { "working": "query.mark_variant == 1" },
            { "celebrating": "query.mark_variant == 2" }
          ]
        },
        "working": {
          "animations": [ "look", "work" ],
          "transitions": [
            { "celebrating": "query.mark_variant == 2" },
            { "idle": "query.mark_variant != 1" }
          ]
        },
        "celebrating": {
          "animations": [ "celebrate" ],
          "transitions": [
            { "working": "query.mark_variant == 1" },
            { "idle": "query.mark_variant != 2" }
          ]
        }
      }
    }
  }
}
