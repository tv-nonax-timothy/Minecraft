{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.nonax_architect": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.rank1",
            "Texture.rank2",
            "Texture.rank3",
            "Texture.rank4",
            "Texture.rank5"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Array.skins[math.clamp(query.variant - 1, 0, 4)]" ]
    },
    "controller.render.nonax_architect_hammer": {
      "geometry": "Geometry.hammer",
      "part_visibility": [
        { "nonax_hammer": "query.mark_variant == 1" }
      ],
      "materials": [ { "*": "Material.hammer" } ],
      "textures": [ "Texture.hammer" ]
    }
  }
}
