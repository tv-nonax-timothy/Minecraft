{
  "format_version": "1.20.0",
  "minecraft:block": {
    "description": {
      "identifier": "custom:grass_slab",
      "is_experimental": false
    },
    "components": {
      "minecraft:loot": "loot_tables/blocks/dirt.json",
      "minecraft:geometry": "geometry.half_slab",
      "minecraft:material_instances": {
        "up": {
          "texture": "custom_grass_top",
          "tint_method": "grass", 
          "alpha_masked_tint": true,
          "render_method": "opaque"
