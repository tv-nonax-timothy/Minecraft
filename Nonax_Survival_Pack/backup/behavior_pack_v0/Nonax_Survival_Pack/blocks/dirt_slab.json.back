{
  "format_version": "1.20.0",
  "minecraft:block": {
    "description": {
      "identifier": "custom:dirt_slab",
      "is_experimental": false
    },
    "components": {
      "minecraft:loot": "loot_tables/blocks/dirt.json",
      "minecraft:geometry": "geometry.half_slab",
      "minecraft:material_instances": {
        "*": { "texture": "dirt", "render_method": "opaque" }
      },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.5 },
      "minecraft:collision_box": { "origin": [-8, 0, -8], "size": [16, 8, 16] },
      "minecraft:selection_box": { "origin": [-8, 0, -8], "size": [16, 8, 16] },
      
      // 時間経過（ランダムティック）で草が生えたブロックに変化する設定
      "minecraft:random_ticking": {
        "on_tick": {
          "event": "custom:turn_into_grass"
        }
      }
    },
    "events": {
      "custom:turn_into_grass": {
        "sequence": [
          {
            "condition": "query.block_neighbor_has_any_tag(0, 1, 0, 'dirt') == 0", 
            // 上にブロックが置いてあるかなどの条件チェックを経て変化（ここではシンプルに確率やタイマー、または単純に自身を置換）
            "set_block": {
              "block_type": "custom:grass_slab"
            }
          }
        ]
      }
    }
  }
}